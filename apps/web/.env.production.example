# Production env for apps/web. Set these in the Vercel project
# (Settings -> Environment Variables, Production scope).
#
# NEXT_PUBLIC_* vars are inlined at BUILD time — changing them requires a
# redeploy, not just a restart.

# Base URL of the deployed backend on Render. Same host for both.
# No trailing slash — paths are joined as `${BASE}/api/...`.
NEXT_PUBLIC_API_URL=https://mafia-server-lz15.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://mafia-server-lz15.onrender.com
