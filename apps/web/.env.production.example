# Production env for apps/web. Set these in the Vercel project
# (Settings -> Environment Variables, Production scope).

# --- Same-origin proxy setup (recommended) ---------------------------------
# The browser talks ONLY to this Vercel deployment. Next.js rewrites (see
# next.config.mjs) proxy /api/* and /socket.io/* to the backend server-side,
# so the session cookie stays first-party and survives on browsers that
# block third-party cookies (iOS Safari, Chrome incognito).
#
# API_ORIGIN is a plain server-side var (NOT NEXT_PUBLIC_) — the browser
# never sees it. No trailing slash.
API_ORIGIN=https://mafia-server-lz15.onrender.com

# Leave NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SOCKET_URL UNSET in production
# so the client uses same-origin requests through the proxy above. Set them
# only for a deployment that deliberately bypasses the proxy (then the
# cross-site cookie caveats apply).
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=
