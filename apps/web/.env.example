# Public URL the browser opens a Socket.IO connection to. Must be reachable
# from the player's device, not just the server host — set this to a real
# domain in staging/production, not localhost.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Public base URL for the REST API (POST /api/session, /api/villages, ...).
# Same host as NEXT_PUBLIC_SOCKET_URL in this app's deployment topology —
# kept as a separate var rather than derived from it so the two can diverge
# behind different reverse-proxy paths without a code change.
NEXT_PUBLIC_API_URL=http://localhost:4000
