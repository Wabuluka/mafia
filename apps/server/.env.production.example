# Production env for apps/server. Set these in the Render dashboard
# (or via render.yaml `sync: false` prompts) — do NOT commit real values.

NODE_ENV=production
PORT=4000

# Exact origin of the deployed frontend. No trailing slash. CORS
# (http/app.ts) and the cross-site session cookie (http/middleware/session.ts)
# both require an exact match.
WEB_ORIGIN=https://your-app.vercel.app

# MongoDB Atlas connection string. PLACEHOLDER ONLY — never put the real
# URI (with password) in this committed file. Set the real value in the
# Render dashboard.
MONGO_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/mafia?retryWrites=true&w=majority

# Must be >= 32 chars in production or the server refuses to boot (src/env.ts).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Bearer token gating GET /metrics. Generate with: openssl rand -hex 16
METRICS_TOKEN=
