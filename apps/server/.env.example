# Port the Express + Socket.IO server listens on.
PORT=4000

# Origin allowed to connect via CORS / Socket.IO (the Next dev server).
WEB_ORIGIN=http://localhost:3000

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/mafia

# Secret used to sign session/reconnect tokens. Generate a real random value
# for anything beyond local dev.
SESSION_SECRET=dev-secret-change-me
